{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Norviq uses the microphone so you can ask Q questions by voice."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Norviq usa o microfone para poder fazer perguntas ao Q por voz."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Norviq turns your voice into text on your iPhone, then sends that text to Q."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Norviq converte a sua voz em texto no iPhone e depois envia esse texto ao Q."
          }
        }
      }
    }
  },
  "version": "1.0"
}
