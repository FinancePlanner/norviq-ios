require "fileutils"

default_platform(:ios)

PROJECT = "financeplan.xcodeproj"
RELEASE_SCHEME = "financeplan"             # Release → facorreia.financeplan (App Store)
BETA_DEV_SCHEME = "Norviqa TestFlight Dev" # Beta → facorreia.financeplan.beta (TestFlight only)
BUNDLE_ID = "facorreia.financeplan"
BETA_BUNDLE_ID = "facorreia.financeplan.beta"

platform :ios do
  desc "Run the full unit test suite"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: BETA_DEV_SCHEME,
      only_testing: ["financeplanTests"],
      device: "iPhone 17",
      result_bundle: true,
      output_directory: "fastlane/test_output"
    )
  end

  desc "UI smoke tests (slow — not part of PR checks)"
  lane :ui_test do
    run_tests(
      project: PROJECT,
      scheme: BETA_DEV_SCHEME,
      only_testing: ["financeplanUITests/StockDetailTabTests"],
      device: "iPhone 17",
      result_bundle: true,
      output_directory: "fastlane/ui_test_output"
    )
  end

  desc "Build Beta config (facorreia.financeplan.beta) and upload to its TestFlight"
  lane :beta do
    api_key = asc_api_key
    setup_ci if is_ci
    # The beta lane owns signing bootstrap and certificate renewal. Manual
    # release lanes remain read-only consumers of the resulting match assets.
    # Matchfile lists both app identifiers so both App Store profiles refresh.
    match(type: "appstore", readonly: false, api_key: api_key)
    prepare_signing(bundle_id: BETA_BUNDLE_ID, config: "Beta")
    bump_build_number(api_key: api_key, bundle_id: BETA_BUNDLE_ID)

    build_app(
      project: PROJECT,
      scheme: BETA_DEV_SCHEME,
      configuration: "Beta",
      export_method: "app-store",
      output_directory: "fastlane/build"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BETA_BUNDLE_ID,
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )

    upload_dsyms
  end

  desc "One-time: create signing certs/profiles and push them to the match repo"
  lane :seed_signing do
    api_key = asc_api_key
    setup_ci if is_ci
    match(type: "appstore", readonly: false, api_key: api_key)
  end

  desc "Pull live App Store metadata into fastlane/metadata (source of truth for :release)"
  desc "Needs ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 — the same env the :release lane uses."
  desc "Pass live:true to read the released version instead of the editable one."
  lane :download_metadata do |options|
    # Deliberately not `deliver download_metadata`: on deliver 2.230 that
    # subcommand exits 0 having written nothing, and it needs the private key
    # written to a temp file to authenticate. Reading the localizations off
    # Spaceship keeps the key in memory and makes the file layout explicit.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("Could not find #{BUNDLE_ID} on App Store Connect") unless app

    versions = app.get_app_store_versions
    versions.each do |v|
      UI.important("ASC version #{v.version_string} state=#{v.app_store_state}")
    end

    version =
      if options[:live]
        versions.find { |v| v.app_store_state == "READY_FOR_SALE" }
      else
        versions.find { |v| v.app_store_state != "READY_FOR_SALE" } || versions.first
      end
    UI.user_error!("No matching App Store version to read") unless version
    UI.message("Reading version #{version.version_string} (#{version.app_store_state})")

    # Name and subtitle live on the AppInfo record, not on the version — which
    # is why a version-only dump can miss the fields a reviewer quoted.
    app_info = options[:live] ? app.fetch_live_app_info : (app.fetch_edit_app_info || app.fetch_latest_app_info)
    info_localizations = app_info ? app_info.get_app_info_localizations : []
    UI.important("No AppInfo record found — name/subtitle will be missing") unless app_info

    metadata_path = File.expand_path("metadata", __dir__)
    written = []

    version.get_app_store_version_localizations.each do |loc|
      fields = {
        "description.txt" => loc.description,
        "keywords.txt" => loc.keywords,
        "promotional_text.txt" => loc.promotional_text,
        "release_notes.txt" => loc.whats_new,
        "support_url.txt" => loc.support_url,
        "marketing_url.txt" => loc.marketing_url
      }

      if (info = info_localizations.find { |l| l.locale == loc.locale })
        fields["name.txt"] = info.name
        fields["subtitle.txt"] = info.subtitle
        fields["privacy_url.txt"] = info.privacy_policy_url
      end

      dir = File.join(metadata_path, loc.locale)
      FileUtils.mkdir_p(dir)
      fields.each do |filename, value|
        next if value.nil?

        path = File.join(dir, filename)
        File.write(path, value.to_s.end_with?("\n") ? value.to_s : "#{value}\n")
        written << path
      end
    end

    if written.empty?
      UI.error("Wrote 0 files. Try `live:true`.")
    else
      UI.success("Wrote #{written.count} files to fastlane/metadata.")
      flagged = written.select { |f| File.read(f).match?(/gpt|openai/i) }
      if flagged.empty?
        UI.success("No GPT/OpenAI reference in any downloaded field.")
      else
        UI.error("GPT/OpenAI reference in: #{flagged.map { |f| f.sub(metadata_path + '/', '') }.join(', ')}")
      end
    end
  end

  desc "Release to the App Store (phased). Usage: fastlane release [version:1.1]"
  lane :release do |options|
    api_key = asc_api_key
    setup_ci if is_ci
    match(type: "appstore", readonly: is_ci, api_key: api_key)
    prepare_signing(bundle_id: BUNDLE_ID, config: "Release")

    if options[:version]
      increment_version_number(version_number: options[:version], xcodeproj: PROJECT)
    end
    bump_build_number(api_key: api_key, bundle_id: BUNDLE_ID)

    build_app(
      project: PROJECT,
      scheme: RELEASE_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "fastlane/build"
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      submit_for_review: true,
      automatic_release: true,
      phased_release: true,
      precheck_include_in_app_purchases: false,
      force: true, # skip interactive HTML preview
      skip_screenshots: true,
      skip_metadata: false
    )

    upload_dsyms
  end

  desc "Hotfix release: no phased rollout"
  lane :hotfix do |options|
    api_key = asc_api_key
    setup_ci if is_ci
    match(type: "appstore", readonly: is_ci, api_key: api_key)
    prepare_signing(bundle_id: BUNDLE_ID, config: "Release")

    increment_version_number(version_number: options[:version], xcodeproj: PROJECT) if options[:version]
    bump_build_number(api_key: api_key, bundle_id: BUNDLE_ID)

    build_app(
      project: PROJECT,
      scheme: RELEASE_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "fastlane/build"
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      submit_for_review: true,
      automatic_release: true,
      phased_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: true
    )

    upload_dsyms
  end

  # ---- helpers ----

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true
    )
  end

  # Project uses Xcode-managed signing for local dev; CI archives need the
  # match profile pinned explicitly.
  private_lane :prepare_signing do |options|
    bundle_id = options[:bundle_id] || BUNDLE_ID
    config = options[:config] || "Release"
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: "84X9WYBF36",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{bundle_id}",
      targets: ["financeplan"],
      build_configurations: [config]
    )
  end

  # Apple requires CFBundleVersion to exceed every prior upload, even across
  # marketing versions. The newest upload is not necessarily the highest build
  # number, so inspect every build train instead of relying on upload order.
  private_lane :bump_build_number do |options|
    api_key = options[:api_key]
    bundle_id = options[:bundle_id] || BUNDLE_ID
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("Could not find #{bundle_id} on App Store Connect") unless app

    build_numbers = app.get_builds.map { |build| Integer(build.version, exception: false) }.compact
    next_build_number = (build_numbers.max || 0) + 1

    increment_build_number(build_number: next_build_number, xcodeproj: PROJECT)
  end

  private_lane :upload_dsyms do
    next unless ENV["SENTRY_AUTH_TOKEN"]

    sh("npx --yes @sentry/cli upload-dif --org #{ENV.fetch('SENTRY_ORG')} " \
       "--project #{ENV.fetch('SENTRY_PROJECT')} ../fastlane/build")
  end
end
